{
  "name": "tagent-desktop",
  "version": "0.0.0-dev",
  "private": true,
  "description": "TAgent-Desktop — 2.0 骨架重构版（会话=进程常驻 + 双核可拔插）",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "jotai": "^2.17.1",
    "motion": "^12.42.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "dev": "bun run --filter='@tagent/ui' tokens:generate && bun run --filter='@tagent/electron' dev",
    "typecheck": "bun run --filter='*' typecheck",
    "build": "bun run --filter='*' build",
    "test": "vitest run"
  }
}
